generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  name      String
  role      Role     @default(EDITOR)
  avatar    String?
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  news     News[]
  research Research[]
}

enum Role {
  ADMIN
  EDITOR
  LIBRARIAN
  RESEARCHER
}

model News {
  id          String        @id @default(cuid())
  slug        String        @unique
  title       String
  excerpt     String
  body        String
  coverImage  String?
  category    NewsCategory
  status      ContentStatus @default(DRAFT)
  /// Which sub-site this article belongs to. UNIVERSITY = main site, HIGH_SCHOOL = /high-school sub-site.
  site        Site          @default(UNIVERSITY)
  publishedAt DateTime?
  views       Int           @default(0)
  authorId    String
  author      User          @relation(fields: [authorId], references: [id])
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([status, publishedAt])
  @@index([site, status, publishedAt])
}

enum Site {
  UNIVERSITY
  HIGH_SCHOOL
}

enum NewsCategory {
  NEWS
  EVENT
  ANNOUNCEMENT
  RESEARCH
  ACHIEVEMENT
  PROGRAM
}

enum ContentStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

model LibraryBook {
  id              String       @id @default(cuid())
  title           String
  author          String
  isbn            String?
  language        BookLanguage
  category        String
  publisher       String?
  publishYear     Int?
  totalCopies     Int          @default(1)
  availableCopies Int          @default(1)
  coverImage      String?
  description     String?
  shelfLocation   String?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
}

enum BookLanguage {
  MN
  JP
  EN
  OTHER
}

model Research {
  id           String        @id @default(cuid())
  slug         String        @unique
  title        String
  abstract     String
  authors      String
  type         ResearchType
  area         String
  fileUrl      String?
  publishedAt  DateTime?
  status       ContentStatus @default(DRAFT)
  uploadedById String
  uploadedBy   User          @relation(fields: [uploadedById], references: [id])
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
}

enum ResearchType {
  ARTICLE
  CONFERENCE
  BOOK
  THESIS
  PROJECT
}

model Program {
  id               String   @id @default(cuid())
  slug             String   @unique
  name             String
  code             String?
  degree           String
  duration         String
  shortDescription String
  fullDescription  String
  skills           String
  curriculum       String?
  /// "Ажлын боломж" / careers — admin-editable narrative shown on the
  /// program detail page. Optional; defaults to a generic blurb when empty.
  careerOutlook    String?
  language         String
  admissionScore   Int?
  active           Boolean  @default(true)
  icon             String
  order            Int      @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model SiteSettings {
  id             String   @id @default("main")
  schoolName     String
  email          String
  phonePrimary   String
  phoneSecondary String?
  address        String
  facebookUrl    String?
  workingHours   String
  updatedAt      DateTime @updatedAt
}

model ContactSubmission {
  id        String   @id @default(cuid())
  name      String
  email     String
  phone     String?
  subject   String
  message   String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
}

/// Editable single text/image fields keyed by stable identifier (e.g. "home.hero.title.line1").
model SiteContent {
  id        String      @id @default(cuid())
  key       String      @unique
  type      ContentType @default(TEXT)
  value     String
  group     String
  label     String
  hint      String?
  multiline Boolean     @default(false)
  order     Int         @default(0)
  updatedAt DateTime    @updatedAt

  @@index([group, order])
}

enum ContentType {
  TEXT
  IMAGE
}

/// School newspaper "Сонин хэвлэл" — admin uploads each issue (PDF) and the
/// public site lists them as a flipbook reader.
model Newspaper {
  id          String        @id @default(cuid())
  /// Дугаар (62, 63, 64, …)
  issueNumber Int           @unique
  /// Optional нэмэлт гарчиг (хэрэв дугаараас гадна нэр өгмөөр бол)
  title       String?
  /// Гарсан огноо
  publishedAt DateTime?
  /// PDF-ийн URL — Vercel Blob эсвэл /public руу зам.
  fileUrl     String
  /// Optional нүүр зураг (cover thumbnail)
  coverImage  String?
  status      ContentStatus @default(PUBLISHED)
  views       Int           @default(0)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([status, issueNumber])
}

/// Staff member rendered on the org-chart (/about/structure). Each row is
/// keyed by a stable `positionKey` (rector, japanese-dept, …) that the
/// chart node looks up. Admins can swap photo/name/degree per position.
model Staff {
  id          String   @id @default(cuid())
  /// Chart-node identifier — matches the id used in the OrgChart component.
  positionKey String   @unique
  /// "Захирал", "Сургалтын албаны эрхлэгч" — title shown above the name.
  position    String
  /// "Т. Дорждагва" — display name.
  name        String
  /// "Доктор (PhD), Дэд профессор" / "Магистр (MS)" / "Бакалавр (BA)".
  degree      String?
  /// Photo URL (Vercel Blob).
  photo       String?
  /// Short bio rendered in the staff modal.
  bio         String?
  email       String?
  phone       String?
  /// When false the chart node is hidden / non-clickable.
  active      Boolean  @default(true)
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

/// Numeric stats shown on the navy band (Hero/About) — editable list.
model Stat {
  id        String   @id @default(cuid())
  key       String   @unique
  icon      String
  number    String
  label     String
  order     Int      @default(0)
  active    Boolean  @default(true)
  updatedAt DateTime @updatedAt

  @@index([order])
}

/// Open position the school is currently hiring for. Listed on /careers
/// and selectable on the application form. Admin manages the list from
/// /admin/careers.
model JobOpening {
  id          String   @id @default(cuid())
  /// URL-safe slug, e.g. "japanese-teacher".
  slug        String   @unique
  /// Public title shown in the listing, e.g. "Япон хэлний багш".
  title       String
  /// Optional short blurb for the position-detail line.
  description String?
  active      Boolean  @default(true)
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([active, order])
}

/// School regulation / journal entry — admin uploads a PDF with a
/// title, cover image and short description; the public site lists them
/// at /regulations and opens each one in a flipbook PDF reader.
model Regulation {
  id          String        @id @default(cuid())
  /// URL-safe slug, e.g. "surah-juram".
  slug        String        @unique
  title       String
  /// Short blurb shown on the listing card.
  description String?
  /// PDF location — Vercel Blob URL or /public path.
  fileUrl     String
  /// Optional cover thumbnail for the listing card.
  coverImage  String?
  status      ContentStatus @default(PUBLISHED)
  order       Int           @default(0)
  views       Int           @default(0)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([status, order])
}

/// Submission from the public job-application form (7-section). Kept
/// separate from `ContactSubmission` so the admin can triage hiring
/// applications independently from general inquiries.
model JobApplication {
  id          String   @id @default(cuid())
  position    String
  fullName    String
  birthDate   String?
  phone       String
  email       String
  address     String?
  /// JSON-encoded blob of the rest of the structured fields
  /// (education, experience, teaching, skills, motivation, …).
  payload     String
  cvUrl       String?
  diplomaUrl  String?
  read        Boolean  @default(false)
  createdAt   DateTime @default(now())

  @@index([read, createdAt])
}
