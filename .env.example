# ─────────────────────────────────────────────────────────────
# Database (Neon Postgres)
# ─────────────────────────────────────────────────────────────
# Жишээ: postgresql://USER:PASSWORD@ep-xxx-pooler.eu-central-1.aws.neon.tech/neondb?sslmode=require
# Neon → Project → Connection Details → "Pooled connection" авах
DATABASE_URL=

# ─────────────────────────────────────────────────────────────
# NextAuth (v5)
# ─────────────────────────────────────────────────────────────
# `node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"` командаар үүсгэ
AUTH_SECRET=
NEXTAUTH_SECRET=

# Vercel дээр автоматаар .vercel.app домэйн дээр ажиллана. Custom domain нэмбэл өөрчил.
NEXTAUTH_URL=http://localhost:3000

# Reverse proxy ард ажиллаж байгаа бол (Vercel автоматаар тийм байдаг)
AUTH_TRUST_HOST=true

# ─────────────────────────────────────────────────────────────
# Vercel Blob storage (admin зургийн upload)
# ─────────────────────────────────────────────────────────────
# Vercel project → Storage → Create Database → Blob үүсгэхэд автоматаар нэмэгдэнэ.
# Local-д ажиллуулахын тулд `vercel env pull .env.local` командаар хуулж авна.
BLOB_READ_WRITE_TOKEN=

# ─────────────────────────────────────────────────────────────
# Элсэлтийн имэйл самбар — SMTP (mail.mn дээрх сургуулийн имэйл)
# ─────────────────────────────────────────────────────────────
# Сургуулийн одоо байгаа mail.mn имэйлээр шууд илгээнэ. Хостинг панелийн
# "IMAP/POP/SMTP with SSL Hostnames" хэсгээс OUTGOING (SMTP) утгыг харна.
# Ихэвчлэн smtp.mail.mn : 465 (SSL). SMTP_USER нь үндсэн имэйл хаяг,
# SMTP_PASS нь тухайн хаягийн нууц үг. EMAIL_FROM-ийн хаяг нь SMTP_USER-тэй
# ижил байвал зохимжтой (спам болохоос сэргийлнэ).
SMTP_HOST=smtp.mail.mn
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=info@soyolerdem.edu.mn
SMTP_PASS=
EMAIL_FROM="Соёл Эрдэм Дээд Сургууль <info@soyolerdem.edu.mn>"

# ─────────────────────────────────────────────────────────────
# AI туслах (имэйл зохиох / сайжруулах) — Anthropic Claude
# ─────────────────────────────────────────────────────────────
# console.anthropic.com → API Keys. AI_MODEL сонгомол — default нь Haiku 4.5,
# илүү чанартай хэрэгтэй бол claude-sonnet-5 болгож болно.
ANTHROPIC_API_KEY=
AI_MODEL=claude-haiku-4-5-20251001
